# Copie ce fichier en .env.local pour le développement. En production, règle ces valeurs chez l'hébergeur.

# Adresse publique du site (sans / final)
NEXT_PUBLIC_SITE_URL=https://zbekal.com

# E-mail affiché sur le site, et e-mail qui reçoit les formulaires
NEXT_PUBLIC_CONTACT_EMAIL=laurine@zbekal.com
CONTACT_TO=laurine@zbekal.com

# Envoi des e-mails (resend.com, gratuit jusqu'à 3 000 e-mails/mois)
RESEND_API_KEY=
# Expéditeur : laisser vide tant que le domaine n'est pas vérifié chez Resend
# CONTACT_FROM=Zbekal <laurine@zbekal.com>

# Facultatif : CV en PDF déposé dans public/, affiché sur la page Démarche
# NEXT_PUBLIC_CV_FILE=/cv-laurine-girard.pdf

# Facultatif : médiateur de la consommation (CGV)
# NEXT_PUBLIC_MEDIATOR=Nom du médiateur, site web
